# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Web server for the FTW scoring system"
description: "TODO"
maintainer: ["Guillaume Bury"]
authors: ["Guillaume Bury" "Xavier Duquesne"]
license: "GPL-3.0-only"
homepage: "https://github.com/scr4t-dance/ftw"
bug-reports: "https://github.com/scr4t-dance/ftw/issues"
depends: [
  "dune" {>= "3.18"}
  "ftw-lib" {= version}
  "ftw-db" {= version}
  "ftw-api" {= version}
  "dream"
  "dream-html"
  "dream-htmx"
  "fmt"
  "logs"
  "containers"
  "cmdliner" {>= "1.3.0"}
  "dune-site"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/scr4t-dance/ftw.git"
x-maintenance-intent: ["(latest)"]
