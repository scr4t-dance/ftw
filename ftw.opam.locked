opam-version: "2.0"
name: "ftw"
version: "dev"
synopsis: "For The Win: a dance competition library"
description: "Library for the FTW server"
maintainer: "Guillaume Bury <guillaume.bury@gmail.com>"
authors: "Guillaume Bury <guillaume.bury@gmail.com>"
license: "GPL-3.0-or-later"
homepage: "https://github.com/scr4t-dance/ftw"
bug-reports: "git+https://github.com/scr4t-dance/ftw/issues"
depends: [
  "astring" {= "0.8.5"}
  "base" {= "v0.15.2"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2" & with-doc}
  "bigstringaf" {= "0.10.0" & with-doc}
  "bos" {= "0.3.0"}
  "brr" {= "0.0.8" & with-doc}
  "camlp-streams" {= "5.0.1" & with-doc}
  "checkseum" {= "0.5.3" & with-doc}
  "cmdliner" {= "1.3.0"}
  "conf-libev" {= "4-13"}
  "conf-pkg-config" {= "4"}
  "conf-sqlite3" {= "1"}
  "containers" {= "3.18"}
  "cppo" {= "1.8.0"}
  "crunch" {= "4.0.0" & with-doc}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "decompress" {= "1.5.3" & with-doc}
  "dune" {= "3.23.0"}
  "dune-compiledb" {= "0.6.0"}
  "dune-configurator" {= "3.23.0"}
  "either" {= "1.0.0"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "gen" {= "1.1"}
  "hex" {= "1.5.0"}
  "js_of_ocaml" {= "6.2.0" & with-doc}
  "js_of_ocaml-compiler" {= "6.2.0"}
  "js_of_ocaml-toplevel" {= "6.2.0" & with-doc}
  "jsonm" {= "1.0.2"}
  "logs" {= "0.10.0"}
  "lwt" {= "5.9.2"}
  "menhir" {= "20250912"}
  "menhirCST" {= "20250912"}
  "menhirLib" {= "20250912"}
  "menhirSdk" {= "20250912"}
  "num" {= "1.6"}
  "ocaml" {= "5.0.0"}
  "ocaml-base-compiler" {= "5.0.0"}
  "ocaml-compiler-libs" {= "v0.12.4"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "ocplib-endian" {= "1.2"}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "optint" {= "0.3.0" & with-doc}
  "otoml" {= "1.0.5"}
  "parsexp" {= "v0.15.0"}
  "ppx_blob" {= "0.9.0" & with-doc}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.0.3"}
  "ppx_deriving_yojson" {= "3.9.1"}
  "ppxlib" {= "0.35.0"}
  "printbox" {= "0.12"}
  "printbox-text" {= "0.12"}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0" & with-doc}
  "result" {= "1.5" & with-doc}
  "rresult" {= "0.7.0"}
  "sedlex" {= "3.7"}
  "seq" {= "base"}
  "sexplib" {= "v0.15.1"}
  "sexplib0" {= "v0.15.1"}
  "sherlodoc" {= "3.2.1" & with-doc}
  "spelll" {= "0.4"}
  "sqlite3" {= "5.4.1"}
  "sqlite3_utils" {= "0.5"}
  "stdlib-shims" {= "0.3.0"}
  "topkg" {= "1.1.1"}
  "tyxml" {= "4.6.0" & with-doc}
  "uucp" {= "17.0.0"}
  "uunf" {= "17.0.0"}
  "uutf" {= "1.0.4"}
  "yojson" {= "2.2.2"}
]
build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://github.com/scr4t-dance/ftw.git"