
; Deps for cram tests
(cram
  (deps %{bin:ftw})
  (package ftw)
)

; Generate a test DB using the import feature
(rule
  (alias runtest)
  (mode promote)
  (deps (source_tree archive))
  (targets demo.sqlite demo-users.sqlite)
  (action
    (progn
      (run ftw import    --db=demo.sqlite --user-db=demo-users.sqlite --verbosity=error archive)
      (run ftw set-admin --db=demo.sqlite --user-db=demo-users.sqlite --no-init --dancer-id=13 admin passwd)
  ))
)
